{
  "rewrites": [
    { 
      "source": "/.well-known/assetlinks.json", 
      "destination": "/.well-known/assetlinks.json" 
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    { 
      "source": "/(.*)", 
      "destination": "/index.html" 
    }
  ]
}
